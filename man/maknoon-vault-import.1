.SH NAME
maknoon-vault-import - Import vault entries from an encrypted .makn bundle


.SH SYNOPSIS
\fBmaknoon vault import [flags]\fP


.SH DESCRIPTION
Decrypts a bundle created by 'maknoon vault export' and imports all entries
into the target vault. Skips entries that already exist unless --overwrite is set.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for import

.PP
\fB-i\fP, \fB--input\fP=""
	Path to the encrypted .makn bundle (required)

.PP
\fB--overwrite\fP[=false]
	Overwrite existing entries


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--fips\fP[=false]
	Enforce strict FIPS-140 compliant cryptographic standards

.PP
\fB--json\fP[=false]
	Output results in JSON format

.PP
\fB-s\fP, \fB--passphrase\fP=""
	Master passphrase for the vault

.PP
\fB--policy\fP=""
	Path to a declarative governance policy file (JSON)

.PP
\fB--tpm\fP[=false]
	Enable TPM 2.0 hardware-backed storage for keys

.PP
\fB--tpm-device\fP="/dev/tpmrm0"
	Path to the TPM device node

.PP
\fB--tpm-pcrs\fP=[]
	List of PCRs to bind keys to (e.g., 7,14)

.PP
\fB--trace\fP[=false]
	Enable low-level diagnostic tracing to stderr

.PP
\fB-v\fP, \fB--vault\fP="default"
	Name or full path of the vault to use


.SH SEE ALSO
\fBmaknoon-vault(1)\fP


