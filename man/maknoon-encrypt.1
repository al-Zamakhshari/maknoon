.TH "MAKNOON" "1" "Jan 2024" "Maknoon Post-Quantum Engine" "Maknoon Manual"

.SH NAME
maknoon-encrypt - Encrypt one or more files or a directory


.SH SYNOPSIS
\fBmaknoon encrypt  [file2 ...] [flags]\fP


.SH DESCRIPTION
Encrypt one or more files or a directory


.SH OPTIONS
\fB--argon-mem\fP=0
	Argon2id memory in KB

.PP
\fB--argon-threads\fP=0
	Argon2id parallel threads

.PP
\fB--argon-time\fP=0
	Argon2id iterations

.PP
\fB-c\fP, \fB--compress\fP[=false]
	Enable Zstd compression

.PP
\fB-j\fP, \fB--concurrency\fP=0
	Number of parallel workers (0 for auto); note: AES-NI hardware saturates at concurrency=1, so this flag only helps on non-AES-NI targets

.PP
\fB--dry-run\fP[=false]
	Preview what would be encrypted without writing any files

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for encrypt

.PP
\fB-o\fP, \fB--output\fP=""
	Output file path (use - for stdout)

.PP
\fB-s\fP, \fB--passphrase\fP=""
	Passphrase for symmetric encryption

.PP
\fB--profile\fP=""
	Cryptographic profile (nist, conservative)

.PP
\fB--profile-file\fP=""
	Path to a custom profile JSON file

.PP
\fB-p\fP, \fB--public-key\fP=[]
	Path to recipient public key(s)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress progress bars and informational messages

.PP
\fB-r\fP, \fB--recursive\fP[=false]
	Encrypt each file in a directory individually (derives session key once — one KDF cost for the whole run)

.PP
\fB--session-key\fP=""
	Pre-derived 64-char hex key (bypasses KDF — use 'maknoon session derive' to generate)

.PP
\fB--shred\fP[=false]
	Securely delete original file after successful encryption

.PP
\fB--sign-key\fP=""
	Path to your private ML-DSA key for integrated signing

.PP
\fB--stealth\fP[=false]
	Enable fingerprint resistance (headerless)

.PP
\fB--threshold\fP=0
	K-of-N threshold decryption: require K out of N recipients to decrypt (must be ≥ 2)

.PP
\fB--trust-on-first-use\fP[=false]
	Automatically add unknown signers to contacts

.PP
\fB--verbose\fP[=false]
	Enable internal pipeline tracing (slog)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--fips\fP[=false]
	Enforce strict FIPS-140 compliant cryptographic standards

.PP
\fB--json\fP[=false]
	Output results in JSON format

.PP
\fB--passphrase-fd\fP=0
	Read passphrase from file descriptor N (e.g., --passphrase-fd 3  3<<<$(pass show key)). Also settable via MAKNOON_PASSPHRASE_FD

.PP
\fB--passphrase-file\fP=""
	Read passphrase from a file instead of prompting (use - for stdin). Also settable via MAKNOON_PASSPHRASE_FILE

.PP
\fB--policy\fP=""
	Path to a declarative governance policy file (JSON)

.PP
\fB--tpm\fP[=false]
	Enable TPM 2.0 hardware-backed storage for keys

.PP
\fB--tpm-device\fP="/dev/tpmrm0"
	Path to the TPM device node

.PP
\fB--tpm-pcrs\fP=[]
	List of PCRs to bind keys to (e.g., 7,14)

.PP
\fB--trace\fP[=false]
	Enable low-level diagnostic tracing to stderr


