.SH NAME
maknoon-gen-passphrase - Generate a mnemonic passphrase


.SH SYNOPSIS
\fBmaknoon gen passphrase [flags]\fP


.SH DESCRIPTION
Generate a mnemonic passphrase


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for passphrase

.PP
\fB--min-entropy\fP=0
	Minimum required entropy in bits (0 = no check)

.PP
\fB--overwrite\fP[=false]
	Overwrite existing vault entry

.PP
\fB-s\fP, \fB--passphrase\fP=""
	Master passphrase for vault storage

.PP
\fB-p\fP, \fB--separator\fP="-"
	Separator between words

.PP
\fB--store\fP=""
	Store in vault under this service name

.PP
\fB--username\fP=""
	Username field for vault entry

.PP
\fB-v\fP, \fB--vault\fP="default"
	Vault name to store into

.PP
\fB-w\fP, \fB--words\fP=6
	Number of words for the passphrase


