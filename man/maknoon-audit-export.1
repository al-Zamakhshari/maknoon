.TH "MAKNOON" "1" "Jan 2024" "Maknoon Post-Quantum Engine" "Maknoon Manual"

.SH NAME
maknoon-audit-export - Export cryptographic audit log entries, with optional filtering


.SH SYNOPSIS
\fBmaknoon audit export [flags]\fP


.SH DESCRIPTION
Export the forensic audit log. Filters are ANDed together.

.PP
Examples:
  maknoon audit export
  maknoon audit export --action vault_get --status failure
  maknoon audit export --from 2026-01-01T00:00:00Z --to 2026-06-01T00:00:00Z


.SH OPTIONS
\fB--action\fP=""
	Filter by action name (e.g. protect, vault_get, identity_info)

.PP
\fB--from\fP=""
	Include entries at or after this RFC3339 timestamp

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for export

.PP
\fB--status\fP=""
	Filter by status: success or failure

.PP
\fB--to\fP=""
	Include entries at or before this RFC3339 timestamp


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--fips\fP[=false]
	Enforce strict FIPS-140 compliant cryptographic standards

.PP
\fB--json\fP[=false]
	Output results in JSON format

.PP
\fB--passphrase-fd\fP=0
	Read passphrase from file descriptor N (e.g., --passphrase-fd 3  3<<<$(pass show key)). Also settable via MAKNOON_PASSPHRASE_FD

.PP
\fB--passphrase-file\fP=""
	Read passphrase from a file instead of prompting (use - for stdin). Also settable via MAKNOON_PASSPHRASE_FILE

.PP
\fB--policy\fP=""
	Path to a declarative governance policy file (JSON)

.PP
\fB--tpm\fP[=false]
	Enable TPM 2.0 hardware-backed storage for keys

.PP
\fB--tpm-device\fP="/dev/tpmrm0"
	Path to the TPM device node

.PP
\fB--tpm-pcrs\fP=[]
	List of PCRs to bind keys to (e.g., 7,14)

.PP
\fB--trace\fP[=false]
	Enable low-level diagnostic tracing to stderr


.SH SEE ALSO
\fBmaknoon-audit(1)\fP


