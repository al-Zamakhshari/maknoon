.PP
\fB--output-manifest\fP=""
	Write manifest to this path instead of alongside shards (useful with rclone)

.PP
\fB-r\fP, \fB--parity\fP=3
	Number of parity shards (redundancy)

.PP
\fB-s\fP, \fB--passphrase\fP=""
