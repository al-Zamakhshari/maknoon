.SH NAME
maknoon-gen-password - Generate a random character password


.SH SYNOPSIS
\fBmaknoon gen password [flags]\fP


.SH DESCRIPTION
Generate a random character password


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for password

.PP
\fB-l\fP, \fB--length\fP=32
	Length of the generated password

.PP
\fB--min-entropy\fP=0
	Minimum required entropy in bits (0 = no check)

.PP
\fB-n\fP, \fB--no-symbols\fP[=false]
	Exclude symbols from the password

.PP
\fB--overwrite\fP[=false]
	Overwrite existing vault entry

.PP
\fB-s\fP, \fB--passphrase\fP=""
	Master passphrase for vault storage

.PP
\fB--store\fP=""
	Store in vault under this service name

.PP
\fB--username\fP=""
	Username field for vault entry

.PP
\fB-v\fP, \fB--vault\fP="default"
	Vault name to store into


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--fips\fP[=false]
	Enforce strict FIPS-140 compliant cryptographic standards

.PP
\fB--json\fP[=false]
	Output results in JSON format

.PP
\fB--passphrase-fd\fP=0
	Read passphrase from file descriptor N (e.g., --passphrase-fd 3  3<<<$(pass show key)). Also settable via MAKNOON_PASSPHRASE_FD

.PP
\fB--passphrase-file\fP=""
	Read passphrase from a file instead of prompting (use - for stdin). Also settable via MAKNOON_PASSPHRASE_FILE

.PP
\fB--policy\fP=""
	Path to a declarative governance policy file (JSON)

.PP
\fB--tpm\fP[=false]
	Enable TPM 2.0 hardware-backed storage for keys

.PP
\fB--tpm-device\fP="/dev/tpmrm0"
	Path to the TPM device node

.PP
\fB--tpm-pcrs\fP=[]
	List of PCRs to bind keys to (e.g., 7,14)

.PP
\fB--trace\fP[=false]
	Enable low-level diagnostic tracing to stderr


